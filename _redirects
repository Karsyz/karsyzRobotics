# Netlify redirects/rewrites. Copied into dist/ by vite.config.js.
#
# Each known SPA route is rewritten (200) to its own pre-built HTML file, which
# carries that page's <title>/meta tags. Anything else falls through to
# dist/404.html, which Netlify serves with a real HTTP 404 status; it loads the
# same app, which renders the styled "Page not found" page.
#
# Keep in sync with ROUTES in src/config/site.js and the routes in src/App.jsx.
/services   /services.html   200
/portfolio  /portfolio.html  200
/about      /about.html      200
/contact    /contact.html    200
/blog       /blog.html       200
